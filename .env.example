# ---- Database (server-only privileged connection) ----
# Local development (PostgreSQL on localhost, e.g. `pnpm db:start`):
DATABASE_URL=postgresql://jalanin:local_password@127.0.0.1:5432/jalanin
# Connection pool size (per Node process).
PG_POOL_MAX=5

# ---- App ----
# Public origin of the app (links in emails, sitemap, robots).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Recommended: require verified email before final application submit (PRD AUTH-05 [R]).
REQUIRE_VERIFIED_EMAIL=false

# ---- Storage (filesystem) ----
# Private CVs / restricted attachments. MUST be outside the web root.
PRIVATE_UPLOAD_DIR=storage/private
# Public uploads (sanitized filenames only, served with cache headers).
PUBLIC_UPLOAD_DIR=storage/public
# Legacy knobs (kept for one release; ignored by the app):
# STORAGE_BACKEND / STORAGE_BUCKET / STORAGE_LOCAL_DIR have no effect.

# ---- Email ----
# Provider: "smtp" (nodemailer; Mailpit locally, configured SMTP in prod)
# or "log" (file mailbox in .storage-local — development/tests ONLY).
EMAIL_PROVIDER=log
EMAIL_FROM="Jalanin Internships <internships@jalanin.com>"
EMAIL_REPLY_TO=internships@jalanin.com
# Admin alert recipients (comma-separated). Required for new-application alerts.
ADMIN_ALERT_EMAIL=admin@jalanin.com
# Local Mailpit SMTP; production SMTP host/port/credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Secret authorizing the email-dispatch cron endpoint (POST /api/cron/dispatch-emails).
CRON_SECRET=local-dev-cron-secret-change-me
RATE_LIMIT_PEPPER=local-dev-rate-limit-pepper-change-me

# ---- Contact form / abuse protection ----
# Cloudflare Turnstile. Test keys (always pass) for local dev:
#   site key: 1x00000000000000000000AA, secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Documents (interim operational config — NOT a confirmed product requirement, see docs/open-decisions.md B05) ----
ALLOWED_CV_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_CV_EXT=.pdf,.docx
MAX_CV_BYTES=5242880

# ---- Analytics (privacy-respecting, no PII) ----
NEXT_PUBLIC_ANALYTICS_ENABLED=false
