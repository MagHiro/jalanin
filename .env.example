# ---- Database (server-only privileged connection) ----
# Local Docker Postgres (docker compose up -d postgres) / native fallback port 54322.
DATABASE_URL=postgresql://jalanin:jalanin@localhost:54322/jalanin

# ---- Supabase (public-safe values may use NEXT_PUBLIC_) ----
# Local Supabase CLI stack defaults; production uses the hosted project refs.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-dev-anon-key-placeholder
# NEVER expose this to the browser. Server-only (provisioning, storage signing).
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-placeholder
# Direct DB URL for migrations executed by drizzle-kit (same DB as DATABASE_URL locally).
SUPABASE_DB_URL=postgresql://jalanin:jalanin@localhost:54322/jalanin

# ---- Auth ----
# App origin used for Supabase Auth redirects (must be the subdomain in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Recommended: require verified email before final application submit (PRD AUTH-05 [R]).
REQUIRE_VERIFIED_EMAIL=false

# ---- Storage ----
# Backend: "local" (filesystem, dev default) or "supabase" (private bucket, prod).
STORAGE_BACKEND=local
# Directory for the local filesystem backend (git-ignored).
STORAGE_LOCAL_DIR=.storage-local
# Private bucket name used by the Supabase backend.
STORAGE_BUCKET=documents

# ---- Email ----
# Provider: "smtp" (nodemailer; Mailpit locally, any SMTP/Resend-compatible host in prod)
# or "log" (file-based mailbox in .storage-local/mailbox — local dev/tests only, never production).
EMAIL_PROVIDER=log
EMAIL_FROM="Jalanin Internships <internships@jalanin.com>"
EMAIL_REPLY_TO=internships@jalanin.com
# Admin alert recipients (comma-separated). Required for new-application alerts.
ADMIN_ALERT_EMAIL=admin@jalanin.com
# Local Mailpit SMTP; production SMTP host/port/credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Secret authorizing the email-dispatch cron endpoint (POST /api/cron/dispatch-emails).
CRON_SECRET=local-dev-cron-secret-change-me

# ---- Contact form / abuse protection ----
# Cloudflare Turnstile. Test keys (always pass) for local dev:
#   site key: 1x00000000000000000000AA, secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Documents (interim operational config — NOT a confirmed product requirement, see docs/open-decisions.md B05) ----
ALLOWED_CV_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_CV_EXT=.pdf,.docx
MAX_CV_BYTES=5242880

# ---- Analytics (privacy-respecting, no PII) ----
NEXT_PUBLIC_ANALYTICS_ENABLED=false
