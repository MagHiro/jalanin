{
  "name": "jalanin-internships",
  "version": "0.4.0",
  "private": true,
  "description": "Jalanin Internship Platform — Next.js + standalone PostgreSQL + filesystem storage (Docker production)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d postgres mailpit",
    "db:stop": "docker compose stop postgres mailpit",
    "db:reset": "docker compose stop postgres && docker compose rm -f postgres && docker volume rm jalanin_pgdata >/dev/null 2>&1; docker compose up -d postgres && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "stack:start": "docker compose up -d postgres mailpit",
    "stack:stop": "docker compose stop postgres mailpit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:test": "tsx scripts/seed.ts --test",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:internships": "tsx scripts/seed-internships.ts",
    "migrate:supabase-pg": "tsx scripts/migrate-supabase-pg.ts",
    "migrate:supabase-storage": "tsx scripts/migrate-supabase-storage.ts",
    "backup:db": "./scripts/backup-db.sh",
    "backup:files": "./scripts/backup-files.sh",
    "restore:db": "./scripts/restore-db.sh",
    "email:dispatch": "tsx scripts/dispatch-emails.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "3.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.4",
    "gsap": "^3.15.0",
    "lucide-react": "0.454.0",
    "next": "14.2.35",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@next/env": "14.2.35",
    "@playwright/test": "1.49.0",
    "@types/node": "20.17.6",
    "@types/nodemailer": "6.4.16",
    "@types/pg": "8.11.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "drizzle-kit": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
